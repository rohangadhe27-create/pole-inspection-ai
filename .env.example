# Flask Configuration
SECRET_KEY=your_secret_key_here
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (MySQL or SQLite)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=power_line_inspection

# AI Model Path (Custom trained YOLO weights)
MODEL_PATH=model/best.pt
